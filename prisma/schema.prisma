generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  password     String
  role         String        @default("USER") // "USER", "ADMIN", "SUPER_ADMIN"
  lastActiveAt    DateTime          @default(now())
  enrollments  Enrollment[]
  certificates Certificate[]
  grades       Grade[]
  chapterProgress ChapterProgress[]
}

model Course {
  id             String       @id @default(uuid())
  title          String
  description    String
  instructorName String?    
  imageUrl       String?      
  videoUrl       String?      
  chapters       Chapter[]
  enrollments    Enrollment[]
  questions      Question[]   
  grades         Grade[]
}

model Chapter {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  summary  String
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  status     String   @default("ONGOING")
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Question {
  id            String @id @default(uuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionText  String   
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // "A", "B", "C", atau "D"
}

model Grade {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  score     Int      
  isPassed  Boolean  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Certificate {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String   
  issuedAt DateTime @default(now())
}

model ChapterProgress {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  isOpened  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, chapterId]) // Mencegah duplikasi data
}

model ChapterProgress {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  isOpened  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, chapterId])
}